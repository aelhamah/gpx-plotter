node_modules/
dist/
.DS_Store

# Per-PR git worktrees live here — see the "Worktrees" section of docs/dev.md.
# Ignored so a worktree nested inside the checkout never shows up as untracked.
.worktrees/

# Environment files — never commit real secrets
.env
.env.*
!.env.example

# iOS: local MapTiler key. The tracked Secrets.xcconfig only sets an empty
# default and optionally includes this (see ios/App/Secrets.xcconfig).
ios/App/Secrets.local.xcconfig

# iOS: SwiftPM build products for the RouteKit package
ios/RouteKit/.build/
.swiftpm/

# iOS: the Xcode project is generated from ios/App/project.yml by XcodeGen, and
# CI only builds the Swift package, so the project is not tracked. Run
# `xcodegen generate` (see docs/dev.md).
ios/App/*.xcodeproj/

# iOS: the app's Info.plist is written by that same generate, from the
# `info.properties` block in project.yml. Xcode drops custom INFOPLIST_KEY_*
# names, so the MapTiler key has to live there — editing this file directly
# would be overwritten on the next generate.
ios/App/GPXNav/Info.plist

xcuserdata/
*.xcuserstate

# iOS: derived build output
ios/App/build/
DerivedData/
*.xccheckout
*.xcscmblueprint
