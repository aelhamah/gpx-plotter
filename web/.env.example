# Base URL of the tile proxy — the Cloudflare Worker that holds the MapTiler key.
#
# There is no MapTiler key here any more, and that is the point: a key in the
# built JavaScript is readable by anyone who loads the page. The proxy adds the
# key upstream and strips it back out of every style and TileJSON it serves.
#
# Deploy it with `cd proxy && npx wrangler deploy`.
#
# Must also be listed in the proxy's ALLOWED_ORIGINS, which matches the Origin
# header exactly: scheme, host and port, no trailing slash. The dev server's
# port is part of the origin, so `http://localhost:5173` is not the same origin
# as `http://localhost:4173`.
#
# For `npm run dev` against a local Worker instead of the deployed one, run
# `npx wrangler dev` in proxy/ and use http://127.0.0.1:8787 here. ATS permits
# that for the native app via NSAllowsLocalNetworking; the browser does not need
# an exception because http://127.0.0.1 is a secure context.
VITE_TILE_PROXY_BASE_URL=https://gpxnav-tile-proxy.gpxnav.workers.dev